{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contexxxt.dev/schemas/behavioral-eval-suite-1.0.0.json",
  "title": "contexxxt Behavioral Eval Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "cases"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "candidate_skill": { "type": "string", "minLength": 1, "maxLength": 500 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "intent", "prompt", "expected_terms"],
        "properties": {
          "id": { "type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
          "target": { "type": "string", "minLength": 1, "maxLength": 500 },
          "intent": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "prompt": { "type": "string", "minLength": 10, "maxLength": 4000 },
          "expected_terms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 240 } },
          "forbidden_terms": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 240 } },
          "required_evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3, "maxLength": 160 } }
        }
      }
    }
  }
}
