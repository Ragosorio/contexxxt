{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contexxxt.dev/schemas/learning-candidates-1.0.0.json",
  "title": "contexxxt Learning Candidate Store",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "candidates"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "updated_at": { "type": "string", "format": "date-time" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["project", "workspace", "package", "directory", "file", "symbol", "route", "service", "domain", "environment", "surface"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 500 },
        "match": { "enum": ["exact", "prefix", "glob"] }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "at", "reason"],
      "properties": {
        "from": { "enum": ["none", "candidate", "supported", "rejected", "promoted", "superseded"] },
        "to": { "enum": ["candidate", "supported", "rejected", "promoted", "superseded"] },
        "at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidence": { "$ref": "#/$defs/id" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "statement", "scopes", "status", "support_count", "observation_ids", "evidence_refs", "confidence", "authority", "risk", "suggested_form", "created_at", "updated_at", "transition_log"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["fact", "constraint", "decision", "procedure", "reinforcement", "contradiction", "stale", "skill"] },
        "statement": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "scopes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scope" } },
        "status": { "enum": ["candidate", "supported", "rejected", "promoted", "superseded"] },
        "support_count": { "type": "integer", "minimum": 1 },
        "observation_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "authority": { "enum": ["governing", "authoritative", "supporting", "observational", "unknown"] },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "suggested_form": { "enum": ["knowledge", "constraint", "decision", "procedure", "validator", "skill", "none"] },
        "skill_contract": { "$ref": "#/$defs/skillContract" },
        "knowledge_id": { "$ref": "#/$defs/id" },
        "rejection_reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "promotion_eval": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "superseded_by": { "$ref": "#/$defs/id" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "transition_log": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transition" } }
      }
    },
    "skillContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "positive_triggers", "negative_triggers", "boundary_triggers", "workflow", "verification"],
      "properties": {
        "name": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "description": { "type": "string", "minLength": 20, "maxLength": 500 },
        "positive_triggers": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 10, "maxLength": 500 } },
        "negative_triggers": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 10, "maxLength": 500 } },
        "boundary_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prompt", "should_trigger"],
            "properties": {
              "prompt": { "type": "string", "minLength": 10, "maxLength": 500 },
              "should_trigger": { "type": "boolean" }
            }
          }
        },
        "workflow": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 10, "maxLength": 1000 } },
        "verification": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 5, "maxLength": 500 } }
      }
    }
  }
}
