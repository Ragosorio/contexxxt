{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contexxxt.dev/schemas/project-model-1.1.0.json",
  "title": "contexxxt Project Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "snapshot", "evidence", "knowledge"],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "project": { "$ref": "#/$defs/project" },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "knowledge": {
      "type": "array",
      "items": { "$ref": "#/$defs/knowledgeUnit" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "repository": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "created_at", "as_of"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "created_at": { "type": "string", "format": "date-time" },
        "as_of": { "type": "string", "format": "date" },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commit": { "type": "string", "minLength": 7, "maxLength": 64 },
            "tree": { "type": "string", "minLength": 7, "maxLength": 64 },
            "dirty": { "type": "boolean" }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "subject"],
      "properties": {
        "level": {
          "enum": ["governing", "authoritative", "supporting", "observational", "unknown"]
        },
        "subject": { "type": "string", "minLength": 1, "maxLength": 160 },
        "source": { "$ref": "#/$defs/id" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "capabilities_used": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "scopeExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "$ref": "#/$defs/scopeKind" },
        "value": { "type": "string", "minLength": 1, "maxLength": 500 },
        "match": { "enum": ["exact", "prefix", "glob"] }
      }
    },
    "scopeKind": {
      "enum": [
        "project",
        "workspace",
        "package",
        "directory",
        "file",
        "symbol",
        "route",
        "service",
        "domain",
        "environment",
        "surface"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "$ref": "#/$defs/scopeKind" },
        "value": { "type": "string", "minLength": 1, "maxLength": 500 },
        "match": { "enum": ["exact", "prefix", "glob"] },
        "exclude": {
          "type": "array",
          "items": { "$ref": "#/$defs/scopeExclusion" }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["complete", "partial", "unknown", "not-applicable"] },
        "scopes": {
          "type": "array",
          "items": { "$ref": "#/$defs/scope" }
        },
        "gaps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "summary",
        "locator",
        "digest",
        "observed_at",
        "provider",
        "authority",
        "sensitivity"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": [
            "source_fragment",
            "repository_fact",
            "command_result",
            "test_result",
            "human_statement",
            "execution_observation"
          ]
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "key", "value"],
          "properties": {
            "category": {
              "enum": ["repository", "filesystem", "manifest", "command", "ci", "test", "documentation", "instruction", "contexxxt", "structural"]
            },
            "key": { "type": "string", "minLength": 1, "maxLength": 160 },
            "value": { "type": "string", "maxLength": 4000 }
          }
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri"],
          "properties": {
            "uri": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "range": { "type": "string", "minLength": 1, "maxLength": 100 },
            "symbol": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "observed_at": { "type": "string", "format": "date-time" },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "branch", "dirty"],
          "properties": {
            "commit": {
              "anyOf": [
                { "type": "string", "minLength": 7, "maxLength": 64 },
                { "type": "null" }
              ]
            },
            "branch": {
              "anyOf": [
                { "type": "string", "minLength": 1, "maxLength": 240 },
                { "type": "null" }
              ]
            },
            "dirty": { "type": "boolean" }
          }
        },
        "provider": { "$ref": "#/$defs/provider" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "authority": { "$ref": "#/$defs/authority" },
        "sensitivity": {
          "enum": ["public", "internal", "confidential", "secret-reference"]
        }
      }
    },
    "dimensionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "what": { "enum": ["complete", "partial"] },
        "why": { "enum": ["complete", "partial"] },
        "how": { "enum": ["complete", "partial"] },
        "for_what": { "enum": ["complete", "partial"] },
        "which": { "enum": ["complete", "partial"] },
        "who": { "enum": ["complete", "partial"] },
        "where": { "enum": ["complete", "partial"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_by", "method", "created_at"],
      "properties": {
        "created_by": { "enum": ["human", "agent", "importer", "compiler"] },
        "method": { "enum": ["observed", "declared", "inferred", "synthesized"] },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at"],
      "properties": {
        "observed_at": { "type": "string", "format": "date-time" },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date" },
        "expires_when": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "stale": { "type": "boolean" },
        "stale_reason": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "revisionBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 500 },
        "valid_at_commit": { "type": "string", "minLength": 7, "maxLength": 64 },
        "valid_for_tree": { "type": "string", "minLength": 7, "maxLength": 64 },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 500 },
              "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tasks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "agents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["codex", "claude-code", "any"] }
        },
        "environments": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": {
          "enum": [
            "supports",
            "contradicts",
            "supersedes",
            "governs",
            "applies_to",
            "depends_on",
            "implements",
            "validates",
            "produced_by",
            "consumed_by"
          ]
        },
        "target": { "$ref": "#/$defs/id" },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "knowledgeUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "summary",
        "statement",
        "dimensions",
        "scopes",
        "evidence",
        "provenance",
        "authority",
        "confidence",
        "validity",
        "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["fact", "decision", "constraint", "procedure", "goal", "actor", "artifact"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "statement": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "dimensions": { "$ref": "#/$defs/dimensionCoverage" },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scope" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "authority": { "$ref": "#/$defs/authority" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "validity": { "$ref": "#/$defs/validity" },
        "revision_binding": { "$ref": "#/$defs/revisionBinding" },
        "applicability": { "$ref": "#/$defs/applicability" },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationship" }
        },
        "status": { "enum": ["candidate", "active", "disputed", "stale", "superseded", "rejected"] },
        "payload": { "type": "object" }
      }
    }
  }
}
